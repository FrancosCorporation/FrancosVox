#!/usr/bin/env python3
"""Voxtype OSD — overlay na tela com speaker + onda senoidal animada.

Mostra o estado do ditado SEM roubar o foco (o texto cola na caixa de
diálogo onde o cursor estava):

  - recording     : speaker + onda VERMELHA que cresce conforme o volume da voz
  - transcribing  : onda AZUL pulsante + "Transcrevendo..."
  - idle          : janela oculta

Segurança de foco (crítica para a colagem no cursor):
  - set_accept_focus(False) — a janela nunca recebe foco de teclado
  - hint NOTIFICATION + skip-taskbar + keep-above — OSD sem decoração
  - sem present()/grab_focus() — apenas move() + show()
  - click-through — input region vazia (cliques atravessam)
  - ancorado na parte inferior central do monitor — não cobre a caixa de texto

Variáveis de ambiente (para demo/screenshots):
  VOXTYPE_STATE_FILE, VOXTYPE_AUDIO_SOCK, VOXTYPE_OSD_SIZE
"""
import math
import os
import socket
import struct
import sys
import threading
import time

# FORÇA o backend X11 (XWayland). Motivo: no backend Wayland do GTK3 o
# set_skip_taskbar_hint() é um no-op — o compositor nunca recebe o estado
# "pula a taskbar" e o Mutter trata a janela do OSD como app normal, que
# aparece na dock (ícone genérico "francosvox-osd"). No X11 (XWayland) o hint
# vira _NET_WM_STATE_SKIP_TASKBAR e a janela SOME da dock.
if not os.environ.get("DISPLAY"):
    os.environ["DISPLAY"] = ":0"
os.environ["GDK_BACKEND"] = "x11"

import cairo  # DEVE vir antes do gi/Gtk: registra o conversor do cairo.Context
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
STATE_FILE = os.environ.get("VOXTYPE_STATE_FILE", os.path.join(RUNTIME_DIR, "voxtype", "state"))
AUDIO_SOCK = os.environ.get("VOXTYPE_AUDIO_SOCK", os.path.join(RUNTIME_DIR, "voxtype", "audio.sock"))
RESTART_FLAG = os.path.join(RUNTIME_DIR, "voxtype", "restarting")

OSD_W, OSD_H = 400, 120
FRAME_BYTES = 16
DBFS_FLOOR = 42.0          # silêncio fica perto de 0 (onda fininha, como no Gemini)
SMOOTHING = 0.32
FRAME_MS = 33

ACCENT = {
    "recording": (0.96, 0.31, 0.31, 1.0),
    "streaming": (0.96, 0.31, 0.31, 1.0),
    "transcribing": (0.30, 0.68, 0.95, 1.0),
}


def rounded_rect(cr, x, y, w, h, r):
    r = min(r, w / 2.0, h / 2.0)
    cr.move_to(x + r, y)
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def draw_restarting(cr, width, height, phase):
    """Loading no mesmo formato do OSD de gravação (pílula na base da tela):
    anel girando + 'Reiniciando…'. Click-through, sem foco."""
    w, h = float(width), float(height)
    cx, cy = w / 2.0, h / 2.0

    # Pílula de fundo (janela inteira)
    radius = min(24.0, h / 2.0)
    cr.save()
    cr.set_operator(cairo.OPERATOR_SOURCE)
    cr.set_source_rgba(0, 0, 0, 0)
    cr.paint()
    cr.set_source_rgba(0.045, 0.055, 0.10, 0.94)
    rounded_rect(cr, 0, 0, w, h, radius)
    cr.fill()

    # Anel de fundo + arco girando
    r = 20.0
    ring_y = cy - 16
    cr.set_source_rgba(0.35, 0.75, 0.95, 0.18)
    cr.set_line_width(5.0)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.arc(cx, ring_y, r, 0, 2 * math.pi)
    cr.stroke()
    cr.set_source_rgba(0.40, 0.78, 0.97, 0.95)
    a0 = phase * 0.9
    cr.arc(cx, ring_y, r, a0, a0 + 2.2)
    cr.stroke()

    # Texto
    cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(16)
    cr.set_source_rgba(0.92, 0.95, 0.97, 0.95)
    (tx, ty, tw, th, _dx, _dy) = cr.text_extents("Reiniciando…")
    cr.move_to(cx - tw / 2, ring_y + r + 24)
    cr.show_text("Reiniciando…")
    cr.restore()


def draw_osd(cr, width, height, state, level, phase, tick, restarting=False):
    """Desenha o overlay completo. Função pura — usada pelo OSD e pelos
    screenshots do README (docs/generate_screenshots.py).

    Layout (estilo Gemini/onda clássica):
      - pílula escura arredondada ocupando a janela toda
      - speaker à esquerda (arco sonoro cresce com o volume)
      - onda senoidal dominante à direita, SEMPRE contida na pílula
      - sem textos: cor identifica o estado (vermelho=gravando, azul=transcrevendo)
    """
    if restarting:
        draw_restarting(cr, width, height, phase)
        return

    accent = ACCENT.get(state, (0.45, 0.45, 0.50, 0.6))
    recording = state in ("recording", "streaming")
    transcribing = state == "transcribing"

    # Fundo transparente
    cr.save()
    cr.set_operator(cairo.OPERATOR_SOURCE)
    cr.set_source_rgba(0, 0, 0, 0)
    cr.paint()

    # Idle: janela invisível (sem desenhar nada) — nunca desmapeia a janela
    # para não mexer no foco.
    if state not in ("recording", "streaming", "transcribing"):
        cr.restore()
        return

    lvl = max(0.0, min(1.0, level))
    w, h = float(width), float(height)
    cx, cy = w / 2.0, h / 2.0

    # --- Pílula de fundo (janela inteira) ---
    radius = min(24.0, h / 2.0)
    cr.set_source_rgba(0.045, 0.055, 0.10, 0.92)
    rounded_rect(cr, 0, 0, w, h, radius)
    cr.fill()

    # Borda com a cor do estado (pulsa enquanto transcreve)
    pulse = 0.45 + 0.55 * math.sin(tick * 0.09)
    border_alpha = (0.35 + 0.4 * pulse) if transcribing else 0.35
    cr.set_source_rgba(accent[0], accent[1], accent[2], border_alpha)
    cr.set_line_width(1.5)
    rounded_rect(cr, 1, 1, w - 2, h - 2, max(1.0, radius - 1))
    cr.stroke()

    # --- Speaker (esquerda) ---
    sp_y = cy
    bounce = 1.0 + 0.05 * lvl * math.sin(phase * 2.0)
    # corpo do alto-falante (pastilha)
    bx0, bx1 = cx - w * 0.30, cx - w * 0.17
    bw = (bx1 - bx0) * bounce
    bh = (h * 0.30) * bounce
    cr.set_source_rgba(0.93, 0.95, 0.97, 0.96)
    rounded_rect(cr, bx0 - bw / 2, sp_y - bh / 2, bw, bh, 3)
    cr.fill()
    # cone
    cone_x0, cone_x1 = bx1 - bw / 2, bx1 - bw / 2 + 15 * bounce
    cr.move_to(cone_x0, sp_y - bh / 2)
    cr.line_to(cone_x1, sp_y - bh / 2 - 9 * bounce)
    cr.line_to(cone_x1, sp_y + bh / 2 + 9 * bounce)
    cr.line_to(cone_x0, sp_y + bh / 2)
    cr.close_path()
    cr.fill()
    # ondas sonoras (crescem com a voz)
    for i, base in enumerate((7.0, 15.0)):
        r = base + lvl * 9.0
        alpha = min(0.95, (0.3 + 0.2 * i) + 0.5 * lvl)
        cr.set_source_rgba(accent[0], accent[1], accent[2], alpha)
        cr.set_line_width(2.8 - i * 0.6)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.arc(cone_x1, sp_y, r, -0.5, 0.5)
        cr.stroke()

    # --- Onda senoidal dominante (sempre contida) ---
    wave_y = cy
    if recording:
        # silêncio = linha fininha (espectro); voz = onda cresce (curva ^1.6)
        wave_amp = 2.0 + (lvl ** 1.6) * 26.0   # 2..28 → y 32..88 numa pílula de 120
    elif transcribing:
        wave_amp = 16.0 + 5.0 * math.sin(tick * 0.1)
    else:
        wave_amp = 3.0
    wave_x0 = cx + w * 0.05
    wave_x1 = w - 48                       # não encosta nos cantos arredondados
    steps = 88
    freq = 8.0 + 1.5 * lvl                   # onda "enche" um pouco com a voz
    # brilho suave
    cr.set_source_rgba(accent[0], accent[1], accent[2], 0.20)
    cr.set_line_width(7.0)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.move_to(wave_x0, wave_y)
    for i in range(steps + 1):
        t = i / steps
        x = wave_x0 + t * (wave_x1 - wave_x0)
        env = math.sin(math.pi * t)
        y = wave_y + math.sin(t * freq + phase) * wave_amp * env
        cr.line_to(x, y)
    cr.stroke()
    # traço principal
    cr.set_source_rgba(accent[0], accent[1], accent[2], 0.95)
    cr.set_line_width(4.5)
    cr.move_to(wave_x0, wave_y)
    for i in range(steps + 1):
        t = i / steps
        x = wave_x0 + t * (wave_x1 - wave_x0)
        env = math.sin(math.pi * t)
        y = wave_y + math.sin(t * freq + phase) * wave_amp * env
        cr.line_to(x, y)
    cr.stroke()

    cr.restore()


class VoxtypeOSD:
    """Janela overlay transparente, sempre-por-cima, click-through e sem foco."""

    def __init__(self):
        self.state = "idle"
        self.restarting = False
        self.level = 0.0
        self.raw_level = 0.0
        self.phase = 0.0
        self.tick = 0

        self.window = Gtk.Window(type=Gtk.WindowType.POPUP)
        self.window.set_app_paintable(True)
        self.window.set_decorated(False)
        self.window.set_accept_focus(False)
        self.window.set_skip_taskbar_hint(True)
        self.window.set_skip_pager_hint(True)
        self.window.set_keep_above(True)
        self.window.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
        self.window.set_default_size(OSD_W, OSD_H)
        self.window.set_resizable(False)

        screen = self.window.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.window.set_visual(visual)

        self.area = Gtk.DrawingArea()
        self.area.set_size_request(OSD_W, OSD_H)
        self.area.connect("draw", self.on_draw)
        self.window.add(self.area)

        self.position_window()
        self.window.show_all()
        self.enable_click_through()
        # JANELA SEMPRE MAPEADA: mostrar/esconder (map/unmap) faz o compositor
        # mexer no foco (o texto caía em outra janela). Idle = conteúdo
        # transparente; o desenho só aparece em recording/transcribing.
        # A transparência é feita no draw (idle pinta nada).

        threading.Thread(target=self.watch_state, daemon=True).start()
        threading.Thread(target=self.watch_audio, daemon=True).start()
        GLib.timeout_add(FRAME_MS, self.on_tick)

    def enable_click_through(self):
        """Input region vazia: cliques/scroll atravessam a pílula inteira.

        `Gdk.Region` NÃO existe no PyGObject do GTK3 (o tipo é `cairo.Region`);
        o AttributeError resultante era engolido pelo `except` e a janela ficava
        com input region cheia — bloqueando cliques e a rolagem dos apps por
        baixo (ex.: barra de controles do YouTube em tela cheia), mesmo com o
        OSD invisível. `set_pass_through` é no-op no X11 deste GTK, então a
        chamada que vale é a da região vazia."""
        try:
            gdk_win = self.window.get_window()
            if gdk_win is None:
                return
            gdk_win.input_shape_combine_region(cairo.Region(), 0, 0)
            if hasattr(gdk_win, "set_pass_through"):
                gdk_win.set_pass_through(True)
        except Exception as e:
            print(f"francosvox-osd: click-through falhou: {e}", file=sys.stderr)

    def position_window(self):
        try:
            display = Gdk.Display.get_default()
            monitor = display.get_primary_monitor() if display else None
            if monitor is None and display is not None and display.get_n_monitors() > 0:
                monitor = display.get_monitor(0)
            if monitor is not None:
                geo = monitor.get_geometry()
                x = geo.x + (geo.width - OSD_W) // 2
                y = geo.y + geo.height - OSD_H - 64
                self.window.move(x, y)
                return
        except Exception:
            pass
        # Fallback: deixa o compositor centralizar
        self.window.set_position(Gtk.WindowPosition.CENTER)

    def on_draw(self, widget, cr):
        alloc = widget.get_allocation()
        draw_osd(cr, alloc.width, alloc.height, self.state, self.level,
                 self.phase, self.tick, restarting=self.restarting)
        return False

    def on_state_change(self, state, flag):
        """Atualiza estado e o modo "reiniciando" (loading na pílula do OSD)."""
        self.state = state
        if flag != self.restarting:
            self.restarting = flag
        # Sem show/hide: a janela fica sempre mapeada (foco não é mexido).
        self.area.queue_draw()
        return False

    def watch_state(self):
        last = None
        last_flag = None
        while True:
            try:
                with open(STATE_FILE) as f:
                    state = f.read().strip()
            except OSError:
                state = ""
            flag = os.path.exists(RESTART_FLAG)
            if state != last or flag != last_flag:
                last = state
                last_flag = flag
                GLib.idle_add(self.on_state_change, state, flag)
            time.sleep(0.15)

    def watch_audio(self):
        while True:
            try:
                if not os.path.exists(AUDIO_SOCK):
                    time.sleep(1)
                    continue
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(5)
                s.connect(AUDIO_SOCK)
                buf = b""
                while True:
                    try:
                        data = s.recv(FRAME_BYTES)
                        if not data:
                            break
                        buf += data
                        while len(buf) >= FRAME_BYTES:
                            frame = buf[:FRAME_BYTES]
                            buf = buf[FRAME_BYTES:]
                            _seq, _lo, _hi, peak_dbfs = struct.unpack("<Ifff", frame)
                            GLib.idle_add(self.on_audio_level, peak_dbfs)
                    except socket.timeout:
                        continue
                    except OSError:
                        break
            except OSError:
                time.sleep(1)

    def on_audio_level(self, val):
        try:
            dbfs = float(val)
        except (TypeError, ValueError):
            dbfs = -120.0
        if not math.isfinite(dbfs):
            dbfs = -120.0
        lvl = max(0.0, min(1.0, (dbfs + DBFS_FLOOR) / DBFS_FLOOR))
        self.raw_level = lvl
        return False

    def on_tick(self):
        self.tick += 1
        self.phase += 0.14
        active = (self.state in ("recording", "streaming", "transcribing")
                  or self.restarting)
        if self.state in ("recording", "streaming"):
            self.level += (self.raw_level - self.level) * SMOOTHING
        elif self.state == "transcribing":
            self.level = 0.5 + 0.2 * math.sin(self.tick * 0.12)
        else:
            self.level *= 0.9
        # Em idle NÃO redesenha: a janela fica transparente e o processo não
        # gasta ~5% de CPU desenhando 30fps à toa. Enquanto o nível decai sai
        # o frame que limpa a pílula; quando zera, para de desenhar de vez.
        if active or self.level > 0.01:
            self.area.queue_draw()
        return True


def main():
    try:
        VoxtypeOSD()
    except Exception as e:
        print(f"francosvox-osd: {e}", file=sys.stderr)
        sys.exit(1)
    Gtk.main()


if __name__ == "__main__":
    main()