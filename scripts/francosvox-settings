#!/usr/bin/env python3
"""FrancosVox — Painel de Configurações.

Acessível pelo menu do GNOME (busque "FrancosVox") ou direto:
francosvox-settings

Recursos:
  - Captura de atalho: clique no campo, aperte as teclas, solte — vira o
    atalho global do FrancosVox (configura o GNOME em custom0)
  - Idioma de ENTRADA (o que você fala): pt, en, es, fr, de, it, auto
  - Idioma de SAÍDA (tradução): pt, en, es, fr, de, it
  - Inserção: Colar instantâneo (Ctrl+V) ON/OFF — OFF digita visivelmente
  - Aplicar reinicia o daemon quando necessário
"""
import os
import re
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

CONFIG_DIR = os.path.expanduser("~/.config/voxtype")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.toml")
MODE_FILE = os.path.join(CONFIG_DIR, "output_mode")
REPO_PATH_FILE = os.path.expanduser("~/.local/share/francosvox/repo_path")
RUNTIME_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "voxtype")

GNOME_BASE = "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/"
KEYBINDING_HELPER = os.path.expanduser("~/.local/bin/francosvox-keybinding")

LANGUAGES = [
    ("pt", "Português (Brasil)"),
    ("en", "Inglês"),
    ("es", "Espanhol"),
    ("fr", "Francês"),
    ("de", "Alemão"),
    ("it", "Italiano"),
    ("auto", "Automático"),
]

# Saída não tem "Automático": o Whisper precisa do idioma alvo definido.
OUTPUT_LANGUAGES = [
    ("pt", "Português (Brasil)"),
    ("en", "Inglês"),
    ("es", "Espanhol"),
    ("fr", "Francês"),
    ("de", "Alemão"),
    ("it", "Italiano"),
]

MOD_TO_GNOME = {
    Gdk.ModifierType.CONTROL_MASK: "Ctrl",
    Gdk.ModifierType.SHIFT_MASK: "Shift",
    Gdk.ModifierType.MOD1_MASK: "Alt",
    Gdk.ModifierType.SUPER_MASK: "Super",
}


def gsettings_get(key, base=GNOME_BASE):
    try:
        out = subprocess.run(
            ["gsettings", "get", base, key], capture_output=True, text=True, timeout=5)
        return out.stdout.strip().strip("'")
    except Exception:
        return None


def keybinding_get():
    """Binding atual do FrancosVox (o helper acha/reaproveita o slot certo)."""
    try:
        out = subprocess.run(
            [KEYBINDING_HELPER, "get"], capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except Exception:
        pass
    return gsettings_get("binding")


def keybinding_set(binding):
    """Grava o atalho MESCLANDO na lista (não apaga os outros atalhos)."""
    try:
        return subprocess.run(
            [KEYBINDING_HELPER, "set", binding], timeout=10).returncode == 0
    except Exception as e:
        print(f"francosvox-settings: atalho não aplicado: {e}", file=sys.stderr)
        return False


def read_config_value(section, key):
    """Lê valor com aspas OU cru (ex.: translate = true é bool, sem aspas)."""
    try:
        with open(CONFIG_FILE) as f:
            content = f.read()
    except OSError:
        return None
    m = re.search(rf"\[{section}\][^\[]*?^{key}\s*=\s*\"([^\"]+)\"", content, re.M)
    if m:
        return m.group(1)
    m = re.search(rf"\[{section}\][^\[]*?^{key}\s*=\s*([^\s#]+)", content, re.M)
    if m:
        return m.group(1)
    return None


def write_config_value(section, key, value, quoted=True):
    """Escreve valor com aspas (string) ou cru (bool/número).

    IMPORTANTE: o Voxtype espera bool SEM aspas (translate = true). O painel
    antigo gravava "true" com aspas, o que podia quebrar o daemon.
    """
    try:
        with open(CONFIG_FILE) as f:
            content = f.read()
    except OSError:
        return False
    val = f'"{value}"' if quoted else value
    new = re.sub(
        rf'(^\[{section}\]\s*\n(?:[^\[]*\n)*?^({key}\s*=\s*))"[^"]*"',
        rf'\g<1>{val}', content, count=1, flags=re.M)
    if new == content:
        new = re.sub(
            rf'(^\[{section}\]\s*\n(?:[^\[]*\n)*?^({key}\s*=\s*))[^\s#]+',
            rf'\g<1>{val}', content, count=1, flags=re.M)
    if new == content:
        return False
    try:
        with open(CONFIG_FILE, "w") as f:
            f.write(new)
        return True
    except OSError:
        return False


def read_mode():
    try:
        with open(MODE_FILE) as f:
            m = f.read().strip()
        return m if m in ("paste", "type") else "paste"
    except OSError:
        return "paste"


def write_mode(mode):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(MODE_FILE, "w") as f:
        f.write(mode + "\n")


def repo_dir():
    try:
        with open(REPO_PATH_FILE) as f:
            return f.read().strip()
    except OSError:
        return os.path.expanduser("~/Git/voxtype-br")


def restart_daemon():
    """Reinicia o daemon e avisa a bandeja (ícone de loading) até ficar pronto."""
    try:
        os.makedirs(RUNTIME_DIR, exist_ok=True)
        with open(os.path.join(RUNTIME_DIR, "restarting"), "w") as f:
            f.write("1")
    except OSError:
        pass
    subprocess.Popen(
        ["bash", os.path.join(repo_dir(), "scripts", "francosvox-start")],
        start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def keyval_to_gnome(keyval):
    name = Gdk.keyval_name(keyval)
    if not name:
        return None
    if name == "space":
        return "space"
    if name == "Return":
        return "Return"
    if name == "Escape":
        return "Escape"
    if len(name) == 1 and name.isalnum():
        return name.lower()
    if name.startswith("F") and name[1:].isdigit():
        return name
    return name


class HotkeyCapture(Gtk.Entry):
    """Campo que captura a combinação de teclas no release."""

    def __init__(self):
        super().__init__()
        self.set_editable(False)
        self.set_can_focus(True)
        self.set_placeholder_text("Clique e aperte as teclas")
        self.capturing = False
        self.pending_mods = 0
        self.pending_key = None
        self.connect("button-press-event", self.on_click)
        self.connect("key-press-event", self.on_key_press)
        self.connect("key-release-event", self.on_key_release)
        self.set_current(keybinding_get() or "<Ctrl><Shift>space")

    def set_current(self, binding):
        self.set_text(binding or "")

    def on_click(self, widget, event):
        self.capturing = True
        self.pending_mods = 0
        self.pending_key = None
        self.set_text("Aperte as teclas...")
        self.grab_focus()
        return True

    def on_key_press(self, widget, event):
        if not self.capturing:
            return False
        state = event.state
        keyval = event.keyval
        # Modificadores: espera por uma tecla não-modificadora
        if keyval in (Gdk.KEY_Control_L, Gdk.KEY_Control_R,
                      Gdk.KEY_Shift_L, Gdk.KEY_Shift_R,
                      Gdk.KEY_Alt_L, Gdk.KEY_Alt_R,
                      Gdk.KEY_Super_L, Gdk.KEY_Super_R):
            return True
        self.pending_mods = state
        self.pending_key = keyval
        return True

    def on_key_release(self, widget, event):
        if not self.capturing:
            return False
        keyval = event.keyval
        if keyval in (Gdk.KEY_Control_L, Gdk.KEY_Control_R,
                      Gdk.KEY_Shift_L, Gdk.KEY_Shift_R,
                      Gdk.KEY_Alt_L, Gdk.KEY_Alt_R,
                      Gdk.KEY_Super_L, Gdk.KEY_Super_R):
            # Se não há tecla principal ainda, ignora (modifier-only release)
            if self.pending_key is None:
                return True
        if self.pending_key is None:
            return True
        state = event.state
        mods = []
        for mask, name in MOD_TO_GNOME.items():
            if state & mask:
                mods.append(name)
        keyname = keyval_to_gnome(self.pending_key)
        if not keyname:
            self.set_text("Tecla não suportada — tente outra")
            self.capturing = False
            return True
        if not mods:
            self.set_text("Use ao menos um modificador (Ctrl/Shift/Alt/Super)")
            self.capturing = False
            return True
        binding = "<" + "><".join(mods) + ">" + keyname
        self.set_current(binding)
        self.capturing = False
        return True

    def current_binding(self):
        txt = self.get_text()
        return txt if txt and "Aperte" not in txt else None


class SettingsPanel(Gtk.Window):
    def __init__(self):
        super().__init__(title="FrancosVox — Configurações")
        self.set_default_size(460, 320)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(18)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(box)

        # --- Atalho ---
        lbl = Gtk.Label(label="Atalho global (clique no campo e aperte as teclas)")
        lbl.set_halign(Gtk.Align.START)
        box.pack_start(lbl, False, False, 0)
        self.hotkey = HotkeyCapture()
        box.pack_start(self.hotkey, False, False, 0)

        # --- Idioma de entrada ---
        lbl2 = Gtk.Label(label="Idioma de ENTRADA (o que você fala)")
        lbl2.set_halign(Gtk.Align.START)
        box.pack_start(lbl2, False, False, 0)
        self.lang = Gtk.ComboBoxText()
        current_lang = (read_config_value("whisper", "source_language")
                        or read_config_value("whisper", "language") or "pt")
        self.lang_idx = {}
        for i, (code, label) in enumerate(LANGUAGES):
            self.lang.append_text(f"{label} ({code})")
            self.lang_idx[code] = i
        self.lang.set_active(self.lang_idx.get(current_lang, 0))
        self.lang.set_tooltip_text(
            "Idioma que você fala. 'Automático' deixa o Whisper detectar sozinho.")
        box.pack_start(self.lang, False, False, 0)

        # --- Idioma de saída (tradução) ---
        lbl3 = Gtk.Label(label="Idioma de SAÍDA (tradução)")
        lbl3.set_halign(Gtk.Align.START)
        box.pack_start(lbl3, False, False, 0)
        self.out_lang = Gtk.ComboBoxText()
        current_out = (read_config_value("whisper", "target_language")
                       or read_config_value("whisper", "language") or "pt")
        self.out_lang_idx = {}
        for i, (code, label) in enumerate(OUTPUT_LANGUAGES):
            self.out_lang.append_text(f"{label} ({code})")
            self.out_lang_idx[code] = i
        if current_out not in self.out_lang_idx:
            current_out = "pt"
        self.out_lang.set_active(self.out_lang_idx[current_out])
        self.out_lang.set_tooltip_text(
            "O texto sai traduzido no idioma escolhido, por um tradutor\n"
            "local (LibreTranslate, offline):\n"
            "- Inglês: tradução direta pt→en (qualidade real).\n"
            "- Francês/Alemão/Italiano: via inglês (pt→en→fr, etc.).\n"
            "- Espanhol: tradução direta pt→es.\n"
            "- Igual à entrada: sem tradução, transcrição literal.\n"
            "A tradução acontece na hora de colar (tradutor local em :5000).")
        box.pack_start(self.out_lang, False, False, 0)

        # --- Modo de inserção ---
        lbl3 = Gtk.Label(label="Inserção do texto")
        lbl3.set_halign(Gtk.Align.START)
        box.pack_start(lbl3, False, False, 0)
        row = Gtk.Box(spacing=10)
        rowlbl = Gtk.Label(label="Colar instantâneo (Ctrl+V)")
        rowlbl.set_halign(Gtk.Align.START)
        self.paste_switch = Gtk.Switch()
        self.paste_switch.set_active(read_mode() == "paste")
        self.paste_switch.set_tooltip_text(
            "ON: copia e cola tudo de uma vez (recomendado).\n"
            "OFF: digita o texto tecla por tecla (visível).")
        row.pack_start(rowlbl, True, True, 0)
        row.pack_start(self.paste_switch, False, False, 0)
        box.pack_start(row, False, False, 0)

        # --- Botões ---
        btn_box = Gtk.Box(spacing=8)
        btn_box.set_halign(Gtk.Align.END)
        box.pack_end(btn_box, False, False, 0)

        btn_cancel = Gtk.Button(label="Cancelar")
        btn_cancel.connect("clicked", lambda _: self.destroy())
        btn_box.pack_start(btn_cancel, False, False, 0)

        btn_ok = Gtk.Button(label="Aplicar")
        btn_ok.get_style_context().add_class("suggested-action")
        btn_ok.connect("clicked", self.on_apply)
        btn_box.pack_start(btn_ok, False, False, 0)

        self.connect("destroy", Gtk.main_quit)
        self.show_all()

    def on_apply(self, _):
        # 1) Atalho (helper mescla na lista — não apaga atalhos do usuário)
        binding = self.hotkey.current_binding()
        if binding and binding != keybinding_get():
            keybinding_set(binding)

        # 2) Idioma de entrada + saída
        src = LANGUAGES[self.lang.get_active()][0]
        tgt = OUTPUT_LANGUAGES[self.out_lang.get_active()][0]
        # A ENTRADA define o idioma de transcrição do Whisper (language).
        # A SAÍDA é traduzida DEPOIS, na hora de colar (francosvox-type), pelo
        # tradutor local (libretranslate em :5000) — com cadeia via inglês
        # para fr/de/it. translate=true é IGNORADO por esta versão do Voxtype.
        lang = src
        translate = "false"
        old_lang = read_config_value("whisper", "language") or "pt"
        old_trans = read_config_value("whisper", "translate") or "false"
        write_config_value("whisper", "source_language", src)
        write_config_value("whisper", "target_language", tgt)
        changed = False
        if lang != old_lang:
            write_config_value("whisper", "language", lang)
            changed = True
        if translate != old_trans:
            write_config_value("whisper", "translate", translate, quoted=False)
            changed = True

        # 3) Modo de inserção
        write_mode("paste" if self.paste_switch.get_active() else "type")

        # Aplica idioma/tradução reiniciando o daemon
        if changed:
            restart_daemon()

        self.destroy()


def main():
    try:
        SettingsPanel()
    except Exception as e:
        print(f"francosvox-settings: {e}", file=sys.stderr)
        sys.exit(1)
    Gtk.main()


if __name__ == "__main__":
    main()