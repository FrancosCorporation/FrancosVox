#!/bin/bash
# francosvox-type — Cola a transcrição depois que o estado volta a idle.
# Chamado pelo francosvox-toggle (atalho) em segundo plano, após `record stop`.
#
# Por que esperar idle: quando a transcrição termina, o OSD esconde e o foco
# volta à caixa de texto. Colar nesse momento garante que o texto cai na caixa
# certa, sem letras "comidas".
#
# Como cola (em vez de digitar — o usuário não vê a digitação):
#   1. Copia a transcrição para o clipboard (wl-copy)
#   2. VERIFICA com wl-paste que o texto está lá (retenta se falhar)
#   3. Injeta Ctrl+Shift+V — cola em QUALQUER terminal (Ptyxis/gnome-terminal)
#      e em apps GUI. (Ctrl+V puro não cola em terminais.)
#   4. Sempre libera as teclas no final (francosvox-keys-reset) — tecla presa
#      travaria o teclado do usuário.
# Se o wl-copy falhar, cai no ydotool type como plano B.
set -u

LOG=/tmp/francosvox-type.log
exec >> "$LOG" 2>&1
echo "=== $(date '+%T') francosvox-type iniciado ==="
echo "WAYLAND_DISPLAY=$WAYLAND_DISPLAY DISPLAY=$DISPLAY XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/voxtype"
STATE_FILE="$RUNTIME_DIR/state"
TRANS_FILE="/tmp/francosvox-transcript.txt"
KEYS_RESET="$HOME/.local/bin/francosvox-keys-reset"
MODE_FILE="$HOME/.config/voxtype/output_mode"

# Traduz via libretranslate local (127.0.0.1:5000). Par direto quando existe;
# senão cadeia <src> -> en -> <tgt>. Retorna vazio se o servidor não respondeu.
translate_text() {
    python3 - "$1" "$2" "$3" <<'PYEOF'
import json, sys, urllib.request
text, src, tgt = sys.argv[1], sys.argv[2], sys.argv[3]
API = "http://127.0.0.1:5000/translate"

def call(q, s, t):
    req = urllib.request.Request(API, data=json.dumps(
        {"q": q, "source": s, "target": t, "format": "text"}).encode(),
        headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=120) as r:
        return json.load(r).get("translatedText")

def direct(q, s, t):
    try:
        return call(q, s, t)
    except Exception:
        return None

out = direct(text, src, tgt)
if not out and src != "en" and tgt != "en":
    mid = direct(text, src, "en")
    if mid:
        out = direct(mid, "en", tgt)
if out:
    sys.stdout.write(out)
PYEOF
}

# Aguarda o daemon terminar (estado idle = transcrição gravada e OSD escondido).
# Espera até ~120s: na CPU a transcrição do large-v3-turbo pode passar de 30s,
# e antes o script desistia cedo e descartava a colagem.
START_TS=$(date +%s)
for _ in $(seq 1 600); do
    st=""
    [ -f "$STATE_FILE" ] && st=$(tr -d '[:space:]' < "$STATE_FILE" 2>/dev/null || true)
    [ "$st" = "idle" ] && break
    sleep 0.2
done
echo "estado final: ${st:-desconhecido} (após $(( $(date +%s) - START_TS ))s)"

sleep 0.8  # margem: foco volta, OSD esconde de vez

if [ ! -f "$TRANS_FILE" ]; then
    echo "ERRO: sem arquivo de transcrição"
    [ -x "$KEYS_RESET" ] && bash "$KEYS_RESET"
    exit 1
fi

# Só cola se o arquivo foi escrito NESTE ditado (mtime depois do início do
# script). Substitui o antigo "idade < 30s", que descartava transcrições
# demoradas (CPU) e aceitava arquivo de outro ditado feito há pouco.
mtime=$(stat -c %Y "$TRANS_FILE" 2>/dev/null || echo 0)
echo "mtime do transcript: $mtime (início: $START_TS)"
if [ "$mtime" -lt $((START_TS - 1)) ]; then
    echo "arquivo antigo, ignorando"
    [ -x "$KEYS_RESET" ] && bash "$KEYS_RESET"
    exit 0
fi

text="$(cat "$TRANS_FILE" 2>/dev/null || true)"
echo "texto: [$text]"
if [ -z "$text" ]; then
    echo "texto vazio, ignorando"
    [ -x "$KEYS_RESET" ] && bash "$KEYS_RESET"
    exit 0
fi

# --- Tradução de saída (se pedida no painel) ---
# A transcrição sai no idioma de ENTRADA (language). Se a SAÍDA escolhida é
# diferente, traduz agora com o tradutor local (libretranslate :5000), antes
# de colar. Pares diretos (pt_en, pt_es, en_pt, es_pt, en_fr, en_de, en_it)
# são 1 chamada; os demais (fr/de/it a partir de pt) vão via inglês.
CONFIG_FILE="$HOME/.config/voxtype/config.toml"
src_lang="$(grep -oP '^\s*source_language\s*=\s*"?\K[^"\s#]+' "$CONFIG_FILE" 2>/dev/null || echo pt)"
tgt_lang="$(grep -oP '^\s*target_language\s*=\s*"?\K[^"\s#]+' "$CONFIG_FILE" 2>/dev/null || echo "$src_lang")"
echo "idiomas: entrada=$src_lang saída=$tgt_lang"

if [ "$tgt_lang" != "$src_lang" ]; then
    # Tradutor local pode ter sido encerrado pelo watchdog de ociosidade
    # (economia de RAM). Reinicia sob demanda e aguarda ficar pronto.
    if ! curl -s --max-time 2 http://127.0.0.1:5000/health >/dev/null 2>&1; then
        echo "tradutor ocioso encerrado — reiniciando…"
        bash "$HOME/.local/bin/francosvox-translate-start" 2>/dev/null || true
        for _ in $(seq 1 40); do
            curl -s --max-time 2 http://127.0.0.1:5000/health >/dev/null 2>&1 && break
            sleep 0.5
        done
    fi
    translated="$(translate_text "$text" "$src_lang" "$tgt_lang")"
    if [ -n "$translated" ]; then
        text="$translated"
        echo "traduzido ($src_lang -> $tgt_lang): [$text]"
    else
        echo "AVISO: tradutor local indisponível — colando o texto original"
    fi
fi

export XKB_DEFAULT_LAYOUT=br
export XKB_DEFAULT_VARIANT=abnt2

# Modo de inserção escolhido no painel FrancosVox (paste = instantâneo,
# type = digita visivelmente). Antes o painel gravava esse arquivo e ninguém
# o lia — o switch não tinha efeito.
mode="$(tr -d '[:space:]' < "$MODE_FILE" 2>/dev/null || true)"
[ "$mode" = "type" ] || mode="paste"
echo "modo de inserção: $mode"

if [ "$mode" = "type" ]; then
    # Digitação visível, tecla a tecla (requer o layout ABNT2 exportado acima)
    /usr/bin/ydotool type --key-delay 25 -- "$text" 2>/dev/null || true
    sleep 0.2
    [ -x "$KEYS_RESET" ] && bash "$KEYS_RESET"
    echo "=== fim ==="
    exit 0
fi

# 1) Copia para o clipboard (com retry + verificação)
ok=0
for try in 1 2 3; do
    printf '%s' "$text" | wl-copy 2>/dev/null || continue
    sleep 0.4
    got="$(timeout 3 wl-paste 2>/dev/null || true)"
    if [ "$got" = "$text" ]; then
        ok=1
        break
    fi
    echo "verificação falhou (tentativa $try): [$got]"
done

if [ "$ok" = 1 ]; then
    sleep 0.3  # clipboard assentado no compositor
    # Keycodes BRUTOS (29=Ctrl, 42=Shift, 47=V): o ydotool desta versão NÃO
    # injeta combinações nomeadas ("key ctrl+shift+v" sai sem efeito).
    # Sequência completa DOWN..UP, verificada em monitor de eventos.
    /usr/bin/ydotool key 29:1 42:1 47:1 47:0 42:0 29:0 2>/dev/null || true
    echo "paste enviado (Ctrl+Shift+V por keycodes)"
else
    # Plano B: digitação visível
    echo "wl-copy falhou — plano B: digitação"
    /usr/bin/ydotool type --key-delay 25 -- "$text" 2>/dev/null || true
fi

# 2) SEMPRE libera as teclas (tecla presa = teclado travado do usuário)
sleep 0.2
[ -x "$KEYS_RESET" ] && bash "$KEYS_RESET"
echo "=== fim ==="