#!/bin/bash
# francosvox-toggle — Wrapper seguro para o atalho global do GNOME.
# Uso (atalho): francosvox-toggle   # em vez de `voxtype record toggle` puro
#
# Resolve 4 problemas do toggle puro:
#  1. Disparo duplo: o GNOME às vezes entrega o atalho 2x (press + release).
#     Um debounce de ~1,2s ignora o segundo disparo, que senão iniciaria e
#     pararia a gravação em seguida (ditado vazio).
#  2. Toque durante a transcrição: com o toggle puro, apertar o atalho enquanto
#     o estado é "transcribing" é ignorado pelo daemon — parece que "o 2º toque
#     não finaliza / travou". Aqui avisamos ("Transcrevendo, aguarde…") e não
#     enviamos comando que seria ignorado.
#  3. Comandos explícitos: em vez de um toggle cego, enviamos `record start`
#     (quando idle) ou `record stop` (quando gravando), conforme o state file.
#  4. Daemon morto (ex.: depois do reboot): em vez de falhar em silêncio,
#     inicia o daemon (via francosvox-start) e aguarda ficar idle para gravar.
set -u

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/voxtype"
STATE_FILE="$RUNTIME_DIR/state"
DEBOUNCE_FILE="$RUNTIME_DIR/toggle.debounce"
DEBOUNCE_MS=1200

VOXTYPE_BIN="$(command -v voxtype 2>/dev/null || echo /usr/bin/voxtype)"

# Caminho do repo (escrito pelo apply.sh; fallback para o layout padrão)
REPO_DIR=""
if [ -f "$HOME/.local/share/francosvox/repo_path" ]; then
    REPO_DIR="$(cat "$HOME/.local/share/francosvox/repo_path" 2>/dev/null || true)"
fi
if [ -z "$REPO_DIR" ] && [ -d "$HOME/Git/voxtype-br" ]; then
    REPO_DIR="$HOME/Git/voxtype-br"
fi

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a FrancosVox -u low -t 1500 "Voxtype" "$1" 2>/dev/null || true
}

# Um dono de clipboard antigo (wl-copy do ditado anterior) pode travar a
# próxima colagem por ~1min (o GNOME demora a liberar o dono anterior).
# Mata antes de colar — o clipboard vazio troca na hora.
kill_stale_clipboard() {
    pkill -x wl-copy 2>/dev/null || true
}

now_ms() { echo $(( $(date +%s%N) / 1000000 )); }

daemon_alive() {
    local pid
    if [ -f "$RUNTIME_DIR/voxtype.lock" ]; then
        pid=$(cat "$RUNTIME_DIR/voxtype.lock" 2>/dev/null || echo 0)
        case "$pid" in ''|*[!0-9]*) pid=0 ;; esac
        if [ "$pid" -gt 0 ] 2>/dev/null && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    pgrep -f "voxtype.* daemon" >/dev/null 2>&1
}

current_state() {
    if [ -f "$STATE_FILE" ]; then
        tr -d '[:space:]' < "$STATE_FILE" 2>/dev/null || true
    fi
}

ensure_daemon() {
    if daemon_alive && [ "$(current_state)" = "idle" ]; then
        return 0
    fi
    notify "FrancosVox não estava rodando — iniciando…"
    if [ -n "$REPO_DIR" ] && [ -x "$REPO_DIR/scripts/francosvox-start" ]; then
        setsid bash "$REPO_DIR/scripts/francosvox-start" >/dev/null 2>&1 &
    else
        setsid "$VOXTYPE_BIN" daemon >/tmp/francosvox.log 2>&1 &
    fi
    # Aguarda o daemon carregar o modelo e entrar em idle (turbo ~1s, large-v3 ~12s)
    for _ in $(seq 1 60); do
        if daemon_alive && [ "$(current_state)" = "idle" ]; then
            return 0
        fi
        sleep 0.5
    done
    notify "Voxtype demorou para iniciar — tente o atalho de novo."
    return 1
}

# --- Debounce: ignora disparos colados (duplo-fire do atalho) ---
now=$(now_ms)
if [ -f "$DEBOUNCE_FILE" ]; then
    last=$(cat "$DEBOUNCE_FILE" 2>/dev/null || echo 0)
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    # Só debounce se o timestamp antigo for válido e recente (formato antigo
    # em nanossegundos geraria now - last negativo e travaria o atalho).
    if [ "$last" -le "$now" ] && [ $(( now - last )) -lt "$DEBOUNCE_MS" ]; then
        exit 0
    fi
fi
mkdir -p "$RUNTIME_DIR" 2>/dev/null || true
echo "$now" > "$DEBOUNCE_FILE" 2>/dev/null || true

# --- Estado atual do daemon ---
state="$(current_state)"

case "$state" in
    recording|streaming)
        # 2º toque legítimo: PARA, transcreve e digita na janela focada.
        # A digitação é feita em 2º plano (francosvox-type) DEPOIS que o estado
        # volta a idle — o OSD esconde e o foco volta à caixa de texto, então
        # nenhuma letra é perdida. Não clique em outro lugar até o texto sair.
        kill_stale_clipboard
        "$VOXTYPE_BIN" record stop
        if [ -x "$HOME/.local/bin/francosvox-type" ]; then
            setsid bash "$HOME/.local/bin/francosvox-type" >/dev/null 2>&1 < /dev/null &
        fi
        exit 0
        ;;
    transcribing)
        # Transcrição em andamento (na CPU pode levar ~1 min com large-v3-turbo).
        # O daemon ignoraria um toggle aqui — só avisa e aguarda.
        notify "Transcrevendo… aguarde o texto aparecer."
        exit 0
        ;;
    idle|stopped|"")
        # 1º toque: começa a gravar. Se o daemon não estiver pronto (reboot),
        # inicia antes. O foco permanece onde está (o OSD fica no topo e é
        # click-through) — não precisa reclicar na caixa de diálogo.
        if ! ensure_daemon; then
            # Libera o debounce: o usuário pode tentar de novo na hora
            rm -f "$DEBOUNCE_FILE" 2>/dev/null || true
            exit 1
        fi
        exec "$VOXTYPE_BIN" record start
        ;;
    *)
        # Estado desconhecido: toggle genérico como último recurso.
        exec "$VOXTYPE_BIN" record toggle
        ;;
esac